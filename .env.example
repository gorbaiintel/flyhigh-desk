# =====================================================================
# Salin ke .env.local  →  cp .env.example .env.local
# JANGAN commit .env.local. Variabel TANPA prefix NEXT_PUBLIC_ hanya dibaca server.
# =====================================================================

# --- Helius (RPC + Enhanced Transactions) — https://dashboard.helius.dev ---
HELIUS_API_KEY=
HELIUS_API_BASE=https://api-mainnet.helius-rpc.com

# --- PumpPortal (Data API stream) — https://pumpportal.fun ---
PUMPPORTAL_API_KEY=

# --- Hub (relay SSE) ---
HUB_PORT=8787
HUB_ALLOWED_ORIGIN=http://localhost:3000
HUB_MAX_KEYS_PER_CLIENT=60
HUB_MAX_KEYS_TOTAL=200
HUB_MAX_PAID_MSGS_PER_DAY=300000

# --- Web ---
NEXT_PUBLIC_HUB_URL=http://localhost:8787
MAX_BUY_SOL=5

# --- BACKEND REAL-TIME ---
NEXT_PUBLIC_STREAM_SOURCE=hub
NEXT_PUBLIC_BACKEND_WS_URL=ws://localhost:8790/ws
STREAM_TOKEN_SECRET=
SESSION_SECRET=
